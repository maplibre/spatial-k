amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

// Shared by the pre-commit, check, and fix hooks hk derives from this map.
steps {
  // formatters
  ["dprint"] = Builtins.dprint

  // linters
  ["jactionlint"] = Builtins.jactionlint

  ["detekt"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt")
    check = "./gradlew detekt"
    exclusive = true
  }

  // generators
  ["abi-dump"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt", "**/api/*.api", "**/api/*.klib.api")
    check = "./gradlew checkKotlinAbi"
    fix = "./gradlew updateKotlinAbi"
    exclusive = true
  }
}
