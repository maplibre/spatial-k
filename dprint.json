{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "newLineKind": "lf",
    "excludes": ["**/build", "**/.gradle", "kotlin-js-store", "**/*.api"],
    "json": { "indentWidth": 4, "preferSingleLine": true },
    "markdown": { "textWrap": "always" },
    "toml": {},
    // oxc 0.43+ also formats these; leave them to the dedicated plugins.
    "oxc": {
        "json.enabled": false,
        "jsonc.enabled": false,
        "json5.enabled": false,
        "css.enabled": false,
        "scss.enabled": false,
        "less.enabled": false,
        "graphql.enabled": false,
        "yaml.enabled": false,
        "markdown.enabled": false,
        "toml.enabled": false
    },
    "yaml": { "indentWidth": 4 },
    "exec": {
        "commands": [
            {
                "command": "mise run _ktfmt --kotlinlang-style - --stdin-name={{file_path}}",
                "exts": ["kt", "kts"]
            },
            { "command": "google-java-format - --assume-filename {{file_path}}", "exts": ["java"] },
            {
                "command": "pnpm --filter docs exec mdxlint --rc-path .mdxlintrc.json --file-path {{file_path}}",
                "exts": ["mdx"]
            }
        ]
    },
    "plugins": [
        "https://plugins.dprint.dev/json-0.25.2.wasm",
        "https://plugins.dprint.dev/oxc-0.46.0.wasm",
        "https://plugins.dprint.dev/markdown-0.26.0.wasm",
        "https://plugins.dprint.dev/toml-0.9.0.wasm",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
        "https://plugins.dprint.dev/exec-0.8.0.json@1f2dfbf5dec6d2e590b2c8b0ba6dbfaf80d0320fa9bd4c3f4f29efb99cd2bd6f"
    ]
}
