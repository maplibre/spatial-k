{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/build",
    "**/.gradle",
    "kotlin-js-store",
    "**/*.api",
    // Package-manager lockfiles are generated; oxc would only re-indent them.
    "**/pnpm-lock.yaml",
    "**/*-lock.yaml",
    "**/*.lock.yaml",
  ],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 100,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "ktfmt": { "style": "kotlinlang", "lineWidth": 100 },
  "exec": {
    "commands": [
      {
        "command": "pnpm --filter docs exec mdxlint --rc-path .mdxlintrc.json --file-path {{file_path}}",
        "exts": ["mdx"],
      },
    ],
  },
  "plugins": [
    "npm:@dprint/oxc@0.49.1",
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
    "https://plugins.dprint.dev/sargunv/google-java-format-0.1.0.json@168697c8e19478c6492a5f9117d163f6241b26010d04946f8441a9236616486e",
  ],
}
